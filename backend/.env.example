# ==============================================================================
# HERMANOS DRIVERS - BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# IMPORTANT: Never commit your actual .env file to version control.
# Copy this file to .env and replace the placeholder values with your production secrets.

# Application Server
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/hermanos_drivers?schema=public"

# Cross-Origin Resource Sharing (CORS)
# Multiple origins can be comma-separated or matched to your frontend URL
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# JWT Authentication (for protected / admin endpoints)
# Use a strong, random 256-bit secret key in production (e.g., generated with `openssl rand -hex 32`)
JWT_SECRET="hermanos_super_secure_jwt_secret_change_in_production_2026_xyz"
JWT_EXPIRES_IN="7d"
